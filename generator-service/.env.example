# Mock Certificate Generator Service settings.
# Copy to .env and replace every key. Never commit .env.
# Generate real keys with:  cd backend && php artisan generator:keys

# success | fail_twice_then_succeed | always_503 | always_422 | slow
GENERATOR_MODE=success

# Used only when GENERATOR_MODE=slow. Longer than the backend's 10 s timeout.
GENERATOR_SLOW_SECONDS=15

# --- Week 14: secure exchange ---
# Refuse /generate unless it arrived over HTTPS (through the local Caddy proxy).
GENERATOR_REQUIRE_HTTPS=true
# Requests signed more than this many seconds ago (or ahead) are rejected as expired.
GENERATOR_MAX_SKEW_SECONDS=300

# Key IDs this service accepts, comma-separated. During rotation list both the old
# and the new ID; remove an ID to revoke it.
GENERATOR_ACCEPTED_KEY_IDS=k2026a

# One ENCRYPTION and one SIGNING key per key ID (base64: + 32 random bytes).
# They must be different and must match the sender's values in backend/.env.
# FAKE example values below - DO NOT USE.
GENERATOR_ENCRYPTION_KEY_k2026a=base64:RkFLRS1FTkNSWVBUSU9OLUtFWS1ETy1OT1QtVVNFLTA=
GENERATOR_SIGNING_KEY_k2026a=base64:RkFLRS1TSUdOSU5HLUtFWS1ETy1OT1QtVVNFLTAwMDA=
