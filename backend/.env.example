APP_NAME="Certificate Generation Queue"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Structured automation log: storage/logs/automation.log
AUTOMATION_LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Project 21: Certificate Generator Service ---
GENERATOR_URL=http://127.0.0.1:8081
# Shared secret; must match generator-service/.env. Use a long random value. Never commit .env.
GENERATOR_SERVICE_KEY=change-me-to-a-long-random-string
# Seconds before a generator call counts as a (transient) timeout.
GENERATOR_TIMEOUT=10

# --- Retry policy ---
CERT_MAX_ATTEMPTS=3
# Seconds to wait before retry 1 and retry 2.
CERT_RETRY_BACKOFF=10,30
# Up to this many random extra seconds per retry (jitter).
CERT_RETRY_JITTER=5
CERT_STUCK_AFTER_MINUTES=15
CERT_NUMBER_PREFIX=ULS

# Flutter Web origin(s) allowed to call the API, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5000
