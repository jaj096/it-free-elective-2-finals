APP_NAME="Certificate Generation Queue"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Week 14: the API is reached through Caddy over HTTPS (docs/week14/https-setup.md).
APP_URL=https://localhost:8443
APP_REQUIRE_HTTPS=true
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Structured automation log: storage/logs/automation.log
AUTOMATION_LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Project 21: Certificate Generator Service ---
# Week 14: HTTPS through the local Caddy proxy (see docs/week14/https-setup.md).
GENERATOR_URL=https://localhost:8444
# Seconds before a generator call counts as a (transient) timeout.
GENERATOR_TIMEOUT=10
# Refuse to send personal data to a non-https GENERATOR_URL.
GENERATOR_REQUIRE_HTTPS=true
# Local development CA used to verify the generator's TLS certificate (made by scripts/dev-certs.sh).
# Absolute path, or leave empty to use the system trust store. Verification is never turned off.
GENERATOR_CA_BUNDLE=
# Only used by `php artisan generator:security-test` to prove plain HTTP is refused.
GENERATOR_PLAIN_HTTP_URL=http://127.0.0.1:8081

# --- Week 14: secure exchange keys (secrets: never commit .env) ---
# Generate with: php artisan generator:keys   (copy the matching block into generator-service/.env)
# Key ID sent as X-Key-Id so keys can be rotated.
GENERATOR_KEY_ID=k2026a
# XChaCha20-Poly1305 key for requester_name + requester_id_number. FAKE value - DO NOT USE.
GENERATOR_ENCRYPTION_KEY=base64:RkFLRS1FTkNSWVBUSU9OLUtFWS1ETy1OT1QtVVNFLTA=
# HMAC-SHA256 request-signing key. Must differ from the encryption key. FAKE value - DO NOT USE.
GENERATOR_SIGNING_KEY=base64:RkFLRS1TSUdOSU5HLUtFWS1ETy1OT1QtVVNFLTAwMDA=

# --- Retry policy ---
CERT_MAX_ATTEMPTS=3
# Seconds to wait before retry 1 and retry 2.
CERT_RETRY_BACKOFF=10,30
# Up to this many random extra seconds per retry (jitter).
CERT_RETRY_JITTER=5
CERT_STUCK_AFTER_MINUTES=15
CERT_NUMBER_PREFIX=ULS

# Flutter Web origin(s) allowed to call the API, comma-separated.
CORS_ALLOWED_ORIGINS=https://localhost:5000
